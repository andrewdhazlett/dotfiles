// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    // gpt-6-astra postdates plugin 4.19.4's GPT-native-Sisyphus allowlist regex
    // (gpt-5.x only) — without this, chat.message force-reroutes sisyphus -> hephaestus.
    // Remove once the plugin's allowlist covers gpt-6.
    "disabled_hooks": ["no-sisyphus-gpt"],
    "agents": {
      "sisyphus": {
        "model": "anthropic/claude-fable-5-1",
        "reasoning": "medium"
      },
      "hephaestus": {
        "model": "openai/gpt-6-astra-fast",
        "reasoning": "max"
      },
      "oracle": {
        "model": "openai/gpt-6-astra-pro",
        "reasoning": "max"
      },
      "librarian": {
        "model": "anthropic/claude-sonnet-5-5"
      },
      "explore": {
        "model": "anthropic/claude-sonnet-5-5",
        "reasoning": "low"
      },
      "multimodal-looker": {
        "model": "google/antigravity-gemini-3.1-pro",
        "reasoning": "high"
      },
      "prometheus": {
        "model": "anthropic/claude-fable-5-1",
        "reasoning": "max"
      },
      "metis": {
        "model": "openai/gpt-6-astra-fast",
        "reasoning": "max"
      },
      "momus": {
        "model": "openai/gpt-6-astra",
        "reasoning": "high"
      },
      "atlas": {
        "model": "anthropic/claude-sonnet-5-5"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "google/antigravity-gemini-3.1-pro",
        "reasoning": "high"
      },
      "ultrabrain": {
        "model": "openai/gpt-6-astra-pro",
        "reasoning": "max"
      },
      "deep": {
        "model": "openai/gpt-6-astra",
        "reasoning": "max"
      },
      "quick": {
        "model": "anthropic/claude-haiku-4-5"
      },
      "unspecified-low": {
        "model": "openai/gpt-6-astra",
        "reasoning": "low"
      },
      "unspecified-high": {
        "model": "openai/gpt-6-astra",
        "reasoning": "high"
      },
      "writing": {
        "model": "anthropic/claude-sonnet-5-5"
      },
      "artistry": {
        "model": "google/antigravity-gemini-3.1-pro",
        "reasoning": "high"
      }
    }
  },
  "legacy_migrations": {
    "/Users/andrew/.config/opencode/oh-my-openagent.json": [
      "model-version:anthropic/claude-sonnet-4-5->anthropic/claude-sonnet-4-6",
      "model-version:openai/gpt-5.3-codex->openai/gpt-5.4",
      "model-version:openai/gpt-5.5->openai/gpt-5.6"
    ]
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ],
  "[native]": {
    "model_profile": "chatgpt-subscription/gpt-6-astra",
    "categories": {
      "deep-low": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "max"
      },
      "quick": {
        "model": "anthropic-subscription/claude-haiku-4-5"
      },
      "unspecified-high": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "high"
      },
      "unspecified-low": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "low"
      },
      "writing": {
        "model": "anthropic-subscription/claude-sonnet-5-5"
      }
    },
    "agents": {
      "explore": {
        "model": "anthropic-subscription/claude-sonnet-5-5",
        "reasoning": "low"
      },
      "librarian": {
        "model": "anthropic-subscription/claude-sonnet-5-5"
      },
      "plan-consultant": {
        "model": "chatgpt-subscription/gpt-6-astra-fast",
        "reasoning": "max"
      },
      "plan-reviewer": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "high"
      }
    }
  },
  // OMO_PROFILE=work (set by the work-repos .envrc, with OMO_CODING_AGENT_DIR
  // pointing at ~/.omo/profiles/work/agent) bills the work API keys instead of
  // the personal subscriptions; same routing, API-billed providers.
  "profiles": {
    "work": {
      "[native]": {
        "model_profile": "openai/gpt-6-astra",
        "categories": {
          "deep-low": {
            "model": "openai/gpt-6-astra",
            "reasoning": "max"
          },
          "quick": {
            "model": "anthropic/claude-haiku-4-5"
          },
          "unspecified-high": {
            "model": "openai/gpt-6-astra",
            "reasoning": "high"
          },
          "unspecified-low": {
            "model": "openai/gpt-6-astra",
            "reasoning": "low"
          },
          "writing": {
            "model": "anthropic/claude-sonnet-5-5"
          }
        },
        "agents": {
          "explore": {
            "model": "anthropic/claude-sonnet-5-5",
            "reasoning": "low"
          },
          "librarian": {
            "model": "anthropic/claude-sonnet-5-5"
          },
          "plan-consultant": {
            "model": "openai/gpt-6-astra-fast",
            "reasoning": "max"
          },
          "plan-reviewer": {
            "model": "openai/gpt-6-astra",
            "reasoning": "high"
          }
        }
      }
    }
  }
}
